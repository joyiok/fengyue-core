{$APP_DOMAIN} {
	# Everything lives inside one `route` block so it runs in exactly the written
	# order. Outside such a block Caddy sorts directives by kind, and "which of
	# these two proxies answers" is not something to leave to a sort order.
	route {
		header {
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			-Server
		}

		# Only JSON is compressed, and that is deliberate: gzipping
		# text/event-stream is the classic way to break streaming.
		encode zstd gzip {
			match {
				header Content-Type application/json*
			}
		}

		# The API and the probe live on story-core.
		#
		# `flush_interval -1` is what keeps SSE unbuffered. Without it a streamed
		# reply arrives in clumps, which reads as "the model is hanging" — the
		# failure mode this whole stack is arranged to avoid.
		@api path /api/* /health
		reverse_proxy @api story-core:8787 {
			flush_interval -1
		}

		# Everything else is the web client. It never sees an /api request, so it
		# never has to proxy one in production: the dev-only proxy in
		# app/api/v1/ is exactly that.
		reverse_proxy web:3000
	}

	# No `log` block: the service already logs what matters (billing, memory
	# passes, rejected credits) and Caddy's error-only default is enough here.

	# Do not add `admin off`: the Compose healthcheck probes the local admin API
	# on 127.0.0.1:2019, which also keeps that endpoint off the network.
}
