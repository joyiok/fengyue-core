# Copy to .env and fill in.
#
# Everything here is *infrastructure*: where the data lives, how the proxy is
# reached, which ids own the files. Application configuration — the model
# gateway, quotas, credits, the market, memory — lives in the database and is
# edited in the admin UI (账户 → 设置) or with `node src/cli.ts settings set`.
#
# That is deliberate. An environment variable is read exactly once per setting,
# to fill in a row that does not exist yet; after that the row is the truth and
# the variable is ignored. So this file is not something you keep editing, and
# nothing here needs a container restart to "take effect".

# Public hostname(s). A real DNS name gets automatic HTTPS from Caddy. Several
# hosts are allowed, separated by commas or spaces:
#   APP_DOMAIN=chat.example.com, www.chat.example.com
# For an IP-only/private test use the port-only form:
#   APP_DOMAIN=:80
APP_DOMAIN=:80

# Contact address for Let's Encrypt. Empty means "no email" (fine, but you lose
# expiry notices).
CADDY_EMAIL=

TZ=Asia/Shanghai
CADDY_IMAGE=caddy:2-alpine
STORY_IMAGE=story-core:local
STORY_WEB_IMAGE=story-web:local

# Owner of ./data and ./caddy. The containers run as this uid:gid, so files they
# write (SQLite database, user libraries, certificates) are not root-owned and
# the backup script can read them.
PUID=1000
PGID=1000

# Loopback ports for `curl` on the host. Caddy reaches both services over the
# compose network, so neither needs to be public.
STORY_LOCAL_PORT=127.0.0.1:8787
WEB_LOCAL_PORT=127.0.0.1:3000

# ---------------------------------------------------------------------- backup
BACKUP_KEEP=14

# --------------------------------------------------------------------------
# What used to be here: STORY_MODEL_*, STORY_DAILY_TOKENS, STORY_CREDITS_*,
# STORY_MARKET, STORY_MEMORY*, STORY_AUTH, …
#
# They are settings now. First boot seeds them from these variables if they are
# still set, which is why an older .env keeps working; after that the database
# wins. To see or change them:
#
#   node src/cli.ts settings list
#   node src/cli.ts settings set model.endpoint https://api.deepseek.com/v1/chat/completions
#   node src/cli.ts settings set model.name     deepseek-chat
#   node src/cli.ts settings set model.apiKey   sk-...
#
# Two of them need a restart and say so: `auth.enabled`, `server.host`,
# `server.port`.
