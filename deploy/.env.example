# Copy to .env and fill in. Only APP_DOMAIN and the model settings really need
# a value; everything else has a working default in docker-compose.yml.

# Public hostname(s). A real DNS name gets automatic HTTPS from Caddy. Several
# hosts are allowed, separated by commas or spaces:
#   APP_DOMAIN=chat.example.com, www.chat.example.com
# For an IP-only/private test use the port-only form:
#   APP_DOMAIN=:80
APP_DOMAIN=:80

# Contact address for Let's Encrypt. Empty means "no email" (fine, but you lose
# expiry notices).
CADDY_EMAIL=

TZ=Asia/Shanghai
CADDY_IMAGE=caddy:2-alpine
STORY_IMAGE=story-core:local
STORY_WEB_IMAGE=story-web:local

# Owner of ./data and ./caddy. The container runs as this uid:gid, so files it
# writes (SQLite database, user libraries, certificates) are not root-owned and
# the backup script can read them.
PUID=1000
PGID=1000

# Loopback port for `curl` on the host. Caddy reaches the app over the compose
# network, so this does not need to be public.
STORY_LOCAL_PORT=127.0.0.1:8787

# Same for the web client (it serves pages on 3000 inside the stack).
WEB_LOCAL_PORT=127.0.0.1:3000

# ------------------------------------------------------------------ accounts
# on  = accounts, per-user isolation, quotas, credits, market
# off = single-user local mode: no accounts, no quotas, no credits
STORY_AUTH=on
STORY_ALLOW_REGISTRATION=off
STORY_SESSION_TTL_DAYS=30

# --------------------------------------------------------------- model gateway
# Any OpenAI-compatible /chat/completions endpoint.
STORY_MODEL_ENDPOINT=
STORY_MODEL_NAME=
STORY_MODEL_API_KEY=
STORY_MODEL_MAX_TOKENS=2048
STORY_MODEL_TIMEOUT_MS=120000

# ------------------------------------------------------------------- spending
# The operator's ceiling. 0 = unlimited. These are the guardrail against a
# runaway bill; credits (below) are the user-facing balance.
STORY_DAILY_TOKENS=200000
STORY_MONTHLY_TOKENS=3000000
STORY_MAX_TOKENS_PER_REQUEST=2048
STORY_GLOBAL_DAILY_TOKENS=0
STORY_MAX_STREAMS=2

# --------------------------------------------------------- credits and market
STORY_CREDITS_SIGNUP=100
STORY_CREDITS_CHECKIN=10
STORY_CREDITS_INVITE=50
STORY_CREDITS_INVITEE=50
STORY_TOKENS_PER_CREDIT=1000
STORY_MARKET=on

# ---------------------------------------------------------------------- memory
STORY_MEMORY=on
STORY_MEMORY_THRESHOLD=40
STORY_MEMORY_KEEP_RECENT=12
STORY_MEMORY_MAX_TOKENS=500

# ---------------------------------------------------------------------- backup
BACKUP_KEEP=14
