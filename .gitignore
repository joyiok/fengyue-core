node_modules/

# The real config holds an API key; only the example is committed.
story.config.json

# Local library when you run the server against ./library
library/

# Default runtime paths: the account database holds password hashes and the
# usage ledger, and ./data holds per-user character cards and chats.
*.sqlite
*.sqlite-wal
*.sqlite-shm
data/
backups/

# A deployment keeps its state next to the compose file (deploy/data, deploy/caddy),
# and .env there holds the model API key.
deploy/.env
deploy/data/
deploy/backups/
deploy/caddy/

*.log
.DS_Store
